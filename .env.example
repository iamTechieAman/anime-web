# ==============================================================================
# ToonPlayer Environment Configuration
# ==============================================================================

# Site Domain Configuration
# - In Production (Vercel): Set to your canonical domain (e.g. https://www.toonplayer.in)
# - In Local Development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://www.toonplayer.in

# Clerk Authentication (Required for real account login and cloud sync)
# Sign up and obtain these keys from your Clerk Dashboard: https://dashboard.clerk.com
# NOTE: 
#   - For Local Dev & Vercel Preview: Use development keys (pk_test_... and sk_test_...)
#   - For Vercel Production: Use production instance keys (pk_live_... and sk_live_...)
#   - Keep secret keys strictly server-side (never add NEXT_PUBLIC_ to CLERK_SECRET_KEY)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Clerk Route URLs (Domain-relative authorized paths)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# TMDB API (Optional — pre-rendered offline fallbacks exist in public/data/)
TMDB_API_KEY=a46c50a0ccb1bafe2b15665df7fad7e1

# MongoDB Connection (Optional — local browser storage is used if omitted)
MONGODB_URI=

# Web Push VAPID Keys (Optional — for browser push notifications)
NEXT_PUBLIC_VAPID_KEY=
VAPID_PRIVATE_KEY=
